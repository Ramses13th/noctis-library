{
  "name": "noctis-library",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-content.mjs",
    "precheck": "node scripts/prepare-content.mjs",
    "pretest": "node scripts/prepare-content.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/finalize.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test-storage.mjs && node scripts/test-learning.mjs && node scripts/test-reader.mjs",
    "build:render": "npm run check && vite build --base=/ --outDir=dist && node scripts/finalize.mjs dist"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
